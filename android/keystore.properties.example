# android/keystore.properties.example - Template for Release Signing
# DO NOT COMMIT THIS FILE OR STORE PASSWORDS IN GIT
# Store your actual keystore outside the repository (e.g. C:/Users/sidra/secure-keys/)

storeFile=C\:\\path\\to\\your\\secure.keystore
storePassword=YOUR_STRONG_STORE_PASSWORD
keyAlias=sellersuitepro_release_key
keyPassword=YOUR_STRONG_KEY_PASSWORD
